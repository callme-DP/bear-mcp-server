# Chunk/Neo4j 配置示例（复制为 .env 使用）
# 运行前：source .env

# Bear 数据库（可选，默认读取系统路径）
# BEAR_DATABASE_PATH=/Users/you/Library/Group Containers/9K33E3U3T4.net.shinyfrog.bear/Application Data/database.sqlite

# Chunk 生成输出目录
NOTE_VECTORS_DIR=./src/note_vectors_chunk
CHUNK_WINDOW=500
CHUNK_OVERLAP=80

# Neo4j 连接
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=neo4j123

# 相似边生成（0 表示不生成）
CHUNK_SIM_TOPK=5
CHUNK_SIM_TH=0.58
